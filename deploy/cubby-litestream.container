[Unit]
Description=Cubby Litestream replica to S3
After=cubby-server.service

[Container]
Image=docker.io/litestream/litestream:0.5.16
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / LITESTREAM_S3_PATH / LITESTREAM_S3_REGION.
EnvironmentFile=%h/.config/cubby/litestream.env
Volume=cubby-data:/data:Z
Volume=%h/.config/cubby/litestream.yml:/etc/litestream.yml:ro,Z
Exec=replicate -config /etc/litestream.yml

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
