{
  "hostname": "cubby.gantt.pub",
  "session_duration": "24h",
  "apps": [
    {
      "name": "cubby-parent",
      "paths": ["/parent*", "/api/parent*"],
      "policy": { "name": "parent", "decision": "allow", "emails": ["ryan@gantt.pub"] }
    },
    {
      "name": "cubby-public",
      "paths": ["/watch*", "/api/child*", "/assets*", "/_app*", "/healthz"],
      "policy": { "name": "device-token-bypass", "decision": "bypass" }
    }
  ]
}
