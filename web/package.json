{
	"name": "cubby-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"e2e": "playwright test",
		"test": "node --test 'tests/**/*.test.js'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"e2e:full": "playwright test -c playwright.full.config.js",
		"e2e:smoke": "playwright test -c playwright.smoke.config.js"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	}
}
